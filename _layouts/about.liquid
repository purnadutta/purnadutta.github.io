---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span>
        {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile homepage-profile float-{{ page.profile.align | default: 'right' }}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid rounded' %}
          {% endif %}

          {%
            include figure.liquid
            loading="eager"
            path=profile_image_path
            class=profile_image_class
            sizes="180px"
            alt=site.first_name
            cache_bust=true
          %}
        {% endif %}

        {% if page.social %}
          <div class="social mt-2">
            <div class="contact-icons">
              {% include social.liquid %}
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.selected_papers %}
      <section class="homepage-section" id="research">
        <h2>Research</h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="homepage-section" id="news">
        <h2>
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">
            News
          </a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <section class="homepage-section" id="teaching">
  <h2>Teaching</h2>

  <p>Teaching assistant at University of Massachusetts Amherst for:</p>

  <ul style="font-size: 1rem; line-height: 1.7;">
    <li>
      <a href="https://hedyehbeyhaghi.github.io/courses/CS611/"
         target="_blank"
         rel="noopener noreferrer">CS 611</a>,
      graduate course in design and analysis of algorithms
      (Fall 2025).
    </li>
    <li>
      <a href="https://people.cs.umass.edu/%7Esheldon/teaching/cs311/index.html"
         target="_blank"
         rel="noopener noreferrer">CS 311</a>,
      undergraduate course in design and analysis of algorithms
      (Spring 2025).
    </li>
  </ul>
</section>

    <section class="homepage-section" id="service">
      <h2>Service</h2>
      <p>
        <strong>Conference reviewing:</strong>
        COCOON 2026.
      </p>
    </section>

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="homepage-section" id="latest-posts">
        <h2>
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">
            Latest posts
          </a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
